{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gérer mon école",
  "mainBinaryName": "ecoleplus",
  "version": "1.0.3",
  "identifier": "app.ecoleplus.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "publisher": "Gérer mon école",
    "copyright": "© Gérer mon école",
    "category": "Education",
    "shortDescription": "Gestion d'établissement scolaire",
    "longDescription": "Gérer mon école : élèves, appel, notes, bulletins et caisse de votre établissement, dans une application.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["French"], "installMode": "currentUser", "displayLanguageSelector": false }
    },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
